apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: {{ openshift_cluster_name }}
rendezvousIP: {{ openshift_agent_rendezvous_ip }}
hosts:
{% for host in openshift_hosts %}
  - hostname: {{ host.hostname }}
    role: {{ host.role }}
    rootDeviceHints:
      deviceName: "{{ host.root_device_name | default('/dev/vda') }}"
    interfaces:
{% for iface in host.interfaces %}
      - name: {{ iface.name }}
        macAddress: {{ iface.mac_address }}
{% endfor %}
{% if host.network_config is defined %}
{% set nc = host.network_config %}
{# ipv4_addresses: multi-NIC/bond/vlan IPs. Fall back to singular ipv4. #}
{% if nc.ipv4_addresses is defined and (nc.ipv4_addresses | length > 0) %}
{% set addr_list = nc.ipv4_addresses %}
{% elif nc.ipv4 is defined %}
{% set addr_list = [nc.ipv4] %}
{% else %}
{% set addr_list = [] %}
{% endif %}
{% set bonds = nc.bonds | default([nc.bond] if (nc.bond is defined and nc.bond.name is defined) else []) %}
{% set vlans = nc.vlans | default([]) %}
    networkConfig:
      interfaces:
{% for iface in host.interfaces %}
{% set addrs = addr_list | selectattr('interface', 'equalto', iface.name) | list %}
        - name: {{ iface.name }}
          type: ethernet
          state: up
          mac-address: {{ iface.mac_address }}
{% if addrs | length > 0 %}
          ipv4:
            enabled: true
            dhcp: {{ addrs[0].dhcp | default(false) | bool | lower }}
{% if not (addrs[0].dhcp | default(false) | bool) %}
            address:
{% for addr in addrs %}
              - ip: {{ addr.address }}
                prefix-length: {{ addr.prefix_length }}
{% endfor %}
{% endif %}
{% else %}
          ipv4:
            enabled: false
{% endif %}
{% endfor %}
{% for bond in bonds %}
{% set addrs = addr_list | selectattr('interface', 'equalto', bond.name) | list %}
        - name: {{ bond.name }}
          type: bond
          state: up
{% if addrs | length > 0 %}
          ipv4:
            enabled: true
            dhcp: {{ addrs[0].dhcp | default(false) | bool | lower }}
{% if not (addrs[0].dhcp | default(false) | bool) %}
            address:
{% for addr in addrs %}
              - ip: {{ addr.address }}
                prefix-length: {{ addr.prefix_length }}
{% endfor %}
{% endif %}
{% else %}
          ipv4:
            enabled: false
{% endif %}
          link-aggregation:
            mode: {{ bond.mode | default('active-backup') }}
            port:
{% for port in bond.ports %}
              - {{ port }}
{% endfor %}
            options:
              miimon: '{{ bond.miimon | default("100") }}'
{% if bond.primary is defined %}
              primary: {{ bond.primary }}
{% endif %}
{% endfor %}
{% for vlan in vlans %}
{% set addrs = addr_list | selectattr('interface', 'equalto', vlan.name) | list %}
        - name: {{ vlan.name }}
          type: vlan
          state: up
          vlan:
            base-iface: {{ vlan.base_iface }}
            id: {{ vlan.id }}
{% if addrs | length > 0 %}
          ipv4:
            enabled: true
            dhcp: {{ addrs[0].dhcp | default(false) | bool | lower }}
{% if not (addrs[0].dhcp | default(false) | bool) %}
            address:
{% for addr in addrs %}
              - ip: {{ addr.address }}
                prefix-length: {{ addr.prefix_length }}
{% endfor %}
{% endif %}
{% else %}
          ipv4:
            enabled: false
{% endif %}
{% endfor %}
{% if nc.dns_resolver | default([]) | length > 0 %}
      dns-resolver:
        config:
          server:
{% for server in nc.dns_resolver %}
            - {{ server }}
{% endfor %}
{% endif %}
{% if nc.routes | default([]) | length > 0 %}
      routes:
        config:
{% for route in nc.routes %}
          - destination: {{ route.destination }}
            next-hop-address: {{ route.next_hop_address }}
            next-hop-interface: {{ route.next_hop_interface | default(addr_list[0].interface) }}
{% if route.table_id is defined %}
            table-id: {{ route.table_id }}
{% endif %}
{% endfor %}
{% endif %}
{% if nc.route_rules | default([]) | length > 0 %}
      route-rules:
        config:
{% for rule in nc.route_rules %}
          - ip-from: {{ rule.ip_from }}
            route-table: {{ rule.route_table }}
{% if rule.priority is defined %}
            priority: {{ rule.priority }}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
